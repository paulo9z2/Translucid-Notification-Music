<Window x:Class="Translucid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Translucid.App"
        mc:Ignorable="d"
        Title="Translucid" Width="440" Height="172"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" CornerRadius="14" BorderThickness="1" BorderBrush="#2EFFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Degrade translúcido na cor da capa (fica por trás de tudo) -->
            <Rectangle x:Name="GradientOverlay" RadiusX="13" RadiusY="13" Margin="1"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="PaletteTop" Color="#400A0B0D"/>
                        <GradientStop x:Name="PaletteMid" Offset="0.5" Color="#340A0B0D"/>
                        <GradientStop x:Name="PaletteBot" Offset="1" Color="#2A0A0B0D"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CoverFrame" Width="86" Height="86" CornerRadius="10"
                        Background="#11000000" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,86,86"/>
                    </Border.Clip>
                    <Grid>
                        <Image x:Name="CoverImageA" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TranslateTransform x:Name="CoverXformA"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image x:Name="CoverImageB" Stretch="UniformToFill" Opacity="0"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TranslateTransform x:Name="CoverXformB"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleText" Text="Nada tocando" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>

                    <TextBlock x:Name="ArtistText" Grid.Row="1" Margin="0,3,0,0" FontSize="12.5"
                               Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis"/>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevButton" Style="{StaticResource MediaButton}" Content="&#xE892;"
                                HorizontalAlignment="Left" Click="PrevButton_Click"/>
                        <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource MediaButton}"
                                Content="&#xE768;" Width="40" Height="40" FontSize="15" Click="PlayButton_Click"/>
                        <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource MediaButton}"
                                Content="&#xE893;" HorizontalAlignment="Right" Click="NextButton_Click"/>

                        <!-- Botão UPDATE: pill azul flutuando ligeiramente acima do ⏭ -->
                        <Button x:Name="UpdateButton" Grid.Column="2"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-33,2,0" Height="23" Padding="12,0"
                                Content="update" FontSize="11.5" FontWeight="SemiBold"
                                Foreground="#FFFFFFFF" Cursor="Hand" Visibility="Collapsed"
                                ToolTip="Nova versão disponível — clique para atualizar"
                                Click="UpdateButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#5CB8FF" CornerRadius="11.5"
                                            BorderBrush="#80FFFFFF" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#5CB8FF" BlurRadius="10"
                                                              ShadowDepth="0" Opacity="0.65"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#7BCBFF"/>
                                            <Setter TargetName="Bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#5CB8FF" BlurRadius="14"
                                                                      ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D9BE0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Estado "atualizando…" no lugar do pill -->
                        <TextBlock x:Name="UpdateStatusText" Grid.Column="2" Text="" FontSize="10.5"
                                   Foreground="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,-30,4,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0">
                    <TextBlock x:Name="LockIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="Clique direito para travar/desbloquear o widget"/>
                    <TextBlock x:Name="CloseButton" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="#99FFFFFF" Cursor="Hand" MouseLeftButtonDown="CloseButton_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock x:Name="VolumeText" Text="" FontSize="15" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="16,10,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="LyricsToggleButton" Width="16" Height="16" FontFamily="Segoe MDL2 Assets"
                        FontSize="8" Foreground="#99FFFFFF" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Content="&#xE70D;" Click="LyricsToggleButton_Click"
                        ToolTip="Letras sincronizadas" Visibility="Collapsed">
                    <Button.RenderTransform>
                        <RotateTransform x:Name="LyricsChevronRotate" Angle="0" CenterX="8" CenterY="8"/>
                    </Button.RenderTransform>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="0:00" Foreground="#99FFFFFF"
                           FontSize="10.5" FontFamily="Cascadia Mono" VerticalAlignment="Center"/>
                <Border Grid.Column="3" Height="4" CornerRadius="2" Background="#26FFFFFF"
                        VerticalAlignment="Center">
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="#5CB8FF"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="DurationText" Grid.Column="5" Text="0:00" Foreground="#99FFFFFF"
                           FontSize="10.5" FontFamily="Cascadia Mono" VerticalAlignment="Center"/>
            </Grid>

            <!-- Painel de letras: só aparece quando a seta é clicada -->
            <Grid x:Name="LyricsPanel" Grid.Row="2" Margin="16,8,16,0" Visibility="Collapsed">
                <ScrollViewer x:Name="LyricsScroll" Height="228" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- respiro p/ primeira e última linha alcançarem o centro -->
                        <Border x:Name="LyricsSpacerTop" Height="104"/>
                        <ItemsControl x:Name="LyricsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="LineText" Text="{Binding}" FontSize="12.5"
                                               TextAlignment="Center" Cursor="Hand"
                                               MouseLeftButtonDown="LyricLine_Click"
                                               Foreground="#73FFFFFF" Margin="0,5,0,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="LyricsSpacerBottom" Height="104"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="LyricsStatusText" Text="" Foreground="#90FFFFFF" FontSize="12.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Height="228" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>