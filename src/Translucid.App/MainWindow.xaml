<Window x:Class="Translucid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Translucid.App"
        mc:Ignorable="d"
        Title="Translucid" Width="440" Height="172"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" CornerRadius="14" BorderThickness="1" BorderBrush="#2EFFFFFF">
        <Grid Margin="16,14,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CoverFrame" Width="86" Height="86" CornerRadius="10"
                        Background="#11000000" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <Image x:Name="CoverImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleText" Text="Nada tocando" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>

                    <TextBlock x:Name="ArtistText" Grid.Row="1" Margin="0,3,0,0" FontSize="12.5"
                               Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis"/>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevButton" Style="{StaticResource MediaButton}" Content="&#xE892;"
                                HorizontalAlignment="Left" Click="PrevButton_Click"/>
                        <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource MediaButton}"
                                Content="&#xE768;" Width="40" Height="40" FontSize="15" Click="PlayButton_Click"/>
                        <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource MediaButton}"
                                Content="&#xE893;" HorizontalAlignment="Right" Click="NextButton_Click"/>
                    </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0">
                    <TextBlock x:Name="LockIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="Clique direito para travar/desbloquear o widget"/>
                    <TextBlock x:Name="CloseButton" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="#99FFFFFF" Cursor="Hand" MouseLeftButtonDown="CloseButton_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="#99FFFFFF"
                           FontSize="10.5" FontFamily="Cascadia Mono"/>
                <Border Grid.Column="2" Height="4" CornerRadius="2" Background="#26FFFFFF"
                        VerticalAlignment="Center">
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="#5CB8FF"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="DurationText" Grid.Column="4" Text="0:00" Foreground="#99FFFFFF"
                           FontSize="10.5" FontFamily="Cascadia Mono"/>
            </Grid>
        </Grid>
    </Border>
</Window>