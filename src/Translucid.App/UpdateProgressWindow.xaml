<Window x:Class="Translucid.App.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualizando o Translucid"
        Width="380" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- sombra -->
        <Border CornerRadius="12" Background="#30000000" Margin="4"
                Effect="{StaticResource DropShadow}">
            <Border CornerRadius="12" Background="#F2191919" BorderBrush="#26FFFFFF" BorderThickness="1">
                <StackPanel Margin="20,16,20,14">

                    <!-- Título: ícone + texto -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleIcon" Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="15" Foreground="#5CB8FF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" Text="Baixando atualização" FontSize="14.5"
                                   FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock x:Name="TagText" Text="" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#5CB8FF" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>

                    <!-- Barra de progresso pill (trilho #26FFFFFF + fill #5CB8FF) -->
                    <Border x:Name="BarTrack" Height="9" CornerRadius="4.5"
                            Background="#26FFFFFF" Margin="0,18,0,0">
                        <Grid>
                            <Border x:Name="BarFill" HorizontalAlignment="Left"
                                    CornerRadius="4.5" Width="0" Background="#5CB8FF"/>
                            <!-- indeterminado: pulso deslizante -->
                            <Canvas x:Name="IndeterminateHost" Visibility="Collapsed">
                                <Border Canvas.Left="-60" Canvas.Top="0" Width="60" Height="9"
                                        CornerRadius="4.5" Background="#5CB8FF" Opacity="0.85"
                                        x:Name="PulseBlock"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Rodapé: velocidade à esquerda, bytes à direita -->
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="SpeedText" Text="" FontSize="11.5"
                                   Foreground="#C8C8C8" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" FontFamily="Cascadia Mono"/>
                        <TextBlock x:Name="BytesText" Text="" FontSize="11.5"
                                   Foreground="#C8C8C8" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontFamily="Cascadia Mono"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
