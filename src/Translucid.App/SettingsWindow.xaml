<Window x:Class="Translucid.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do Translucid" Width="330" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#2EFFFFFF" CornerRadius="11"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#D8FFFFFF"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4D5CB8FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" CornerRadius="14" BorderThickness="1" BorderBrush="#2EFFFFFF"
            Padding="18,12,18,16">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Configurações" FontSize="15" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="CloseSettingsButton" Grid.Column="1" Content="&#xE711;"
                        Width="26" Height="26" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Foreground="#99FFFFFF" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Fechar" Click="CloseSettingsButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Iniciar com o Windows" FontSize="12.5" Foreground="White"/>
                    <TextBlock Text="Abre o widget junto com o sistema" FontSize="10.5"
                               Foreground="#90FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
                <ToggleButton x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource Switch}"
                              Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sempre atrás das janelas" FontSize="12.5" Foreground="White"/>
                    <TextBlock Text="Widget fica abaixo de todos os apps" FontSize="10.5"
                               Foreground="#90FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
                <ToggleButton x:Name="BottomToggle" Grid.Column="1" Style="{StaticResource Switch}"
                              Checked="BottomToggle_Changed" Unchecked="BottomToggle_Changed"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Letras sincronizadas" FontSize="12.5" Foreground="White"/>
                    <TextBlock Text="Seta no widget expande a letra da música" FontSize="10.5"
                               Foreground="#90FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
                <ToggleButton x:Name="LyricsToggle" Grid.Column="1" Style="{StaticResource Switch}"
                              Checked="LyricsToggle_Changed" Unchecked="LyricsToggle_Changed"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Atalhos globais" FontSize="12.5" Foreground="White"/>
                    <TextBlock Text="Ctrl+Alt+P play/pause  •  N próxima  •  B anterior" FontSize="10.5"
                               Foreground="#90FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
                <ToggleButton x:Name="HotkeysToggle" Grid.Column="1" Style="{StaticResource Switch}"
                              Checked="HotkeysToggle_Changed" Unchecked="HotkeysToggle_Changed"/>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Redimensionamento estendido" FontSize="12.5" Foreground="White"/>
                    <TextBlock Text="Ativa opção B: até 1200×800 e escala 2.5× (off dorme em 900×600)" FontSize="10.5"
                               Foreground="#90FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
                <ToggleButton x:Name="ExtendedResizeToggle" Grid.Column="1" Style="{StaticResource Switch}"
                              Checked="ExtendedResizeToggle_Changed" Unchecked="ExtendedResizeToggle_Changed"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>